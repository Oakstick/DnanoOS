{
  "name": "void-harvest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node tools/package.mjs",
    "vox:import": "node tools/vox.mjs import",
    "vox:export": "node tools/vox.mjs export",
    "build:standalone": "tsc --noEmit && vite build --config vite.standalone.config.ts && node tools/standalone.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
